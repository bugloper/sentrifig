<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Selise Sentry</title>
  <%= csrf_meta_tags %>
  <style>
    :root { color-scheme: light; }
    * { box-sizing: border-box; }
    body {
      margin: 0; padding: 2rem 1rem; background: #f4f5f7; color: #1f2933;
      font: 15px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }
    main { max-width: 32rem; margin: 0 auto; }
    h1 { font-size: 1.4rem; margin: 0 0 1.5rem; }
    h2 { font-size: 0.85rem; text-transform: uppercase; letter-spacing: .06em; color: #616e7c; margin: 1.5rem 0 .5rem; }
    .card { background: #fff; border: 1px solid #d9dde3; border-radius: 8px; padding: 1.5rem; }
    .env { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-weight: 600; }
    .status {
      border: 2px solid; border-radius: 6px; padding: 1.25rem; text-align: center;
      font-size: 1.6rem; font-weight: 700; letter-spacing: .08em;
    }
    .status.enabled  { border-color: #2f855a; color: #22543d; background: #f0fff4; }
    .status.disabled { border-color: #c53030; color: #742a2a; background: #fff5f5; }
    .meta { color: #616e7c; font-size: .9rem; margin: .75rem 0 0; }
    .actions { margin-top: 1.5rem; }
    .btn {
      display: inline-block; width: 100%; padding: .8rem 1rem; border: 0; border-radius: 6px;
      font: inherit; font-weight: 600; cursor: pointer; color: #fff;
    }
    .btn.danger  { background: #c53030; }
    .btn.primary { background: #2f855a; }
    .btn:hover { filter: brightness(.95); }
    .flash { border-radius: 6px; padding: .75rem 1rem; margin-bottom: 1rem; }
    .flash.notice { background: #e6fffa; color: #234e52; border: 1px solid #81e6d9; }
    .flash.alert  { background: #fff5f5; color: #742a2a; border: 1px solid #feb2b2; }
    footer { color: #7b8794; font-size: .8rem; margin-top: 1.5rem; text-align: center; }
  </style>
</head>
<body>
  <main>
    <h1>Selise Sentry</h1>
    <% if notice %><div class="flash notice" role="status"><%= notice %></div><% end %>
    <% if alert %><div class="flash alert" role="alert"><%= alert %></div><% end %>
    <%= yield %>
    <footer>selise-sentry <%= SeliseSentry::VERSION %></footer>
  </main>
</body>
</html>
