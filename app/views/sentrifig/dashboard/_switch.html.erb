<% backend = status.scope == Sentrifig::Scope::BACKEND %>
<section class="card">
  <header class="scope-head">
    <div>
      <h2><%= backend ? "Backend" : "Frontend" %></h2>
      <p class="sub">
        <% if backend %>
          Ruby events from this application &mdash; exceptions, messages, transactions, cron check-ins.
        <% else %>
          Browser events from clients reading this state. Nothing in this process reads it.
        <% end %>
      </p>
    </div>

    <div class="scope-state">
      <span class="<%= class_names("pill", enabled: status.enabled?, disabled: !status.enabled?) %>"><%= status.label %></span>
      <% if status.enabled? %>
        <%= button_to "Disable #{status.scope} Sentry", scoped_disable_path(scope: status.scope),
                      method: :post, class: "btn danger" %>
      <% else %>
        <%= button_to "Enable #{status.scope} Sentry", scoped_enable_path(scope: status.scope),
                      method: :post, class: "btn primary" %>
      <% end %>
    </div>
  </header>

  <p class="<%= class_names("meta", degraded: status.degraded?) %>">
    <% if status.persisted? %>
      Last changed
      <% if status.changed_at %>at <time datetime="<%= status.changed_at.iso8601 %>"><%= status.changed_at.utc.strftime("%Y-%m-%d %H:%M UTC") %></time><% end %>
      by <%= status.changed_by.presence || "unknown" %>.
    <% elsif status.degraded? %>
      The database is unreachable. Showing the last known state; changes cannot be saved right now.
    <% else %>
      Never changed here &mdash; this is the default.
    <% end %>
    <% if backend %>
      Applies to every process of this environment within <%= status.cache_ttl %>s.
    <% else %>
      Picked up by browser clients within <%= Sentrifig.configuration.client_poll_interval %>s, with no reload.
    <% end %>
  </p>

  <%= render "settings", status: status %>
</section>
