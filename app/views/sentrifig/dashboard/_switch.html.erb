<div class="card">
  <h2><%= status.scope == Sentrifig::Scope::BACKEND ? "Backend &mdash; Ruby events".html_safe : "Frontend &mdash; browser events".html_safe %></h2>

  <p class="meta">
    <% if status.scope == Sentrifig::Scope::BACKEND %>
      Gates events raised by this application: exceptions, messages, transactions and cron check-ins.
    <% else %>
      Gates events raised by browser clients that read this state. Nothing in this process reads it.
    <% end %>
  </p>

  <div class="status <%= status.enabled? ? 'enabled' : 'disabled' %>">
    <%= status.label %>
  </div>

  <p class="meta">
    <% if status.persisted? %>
      Last changed
      <% if status.changed_at %>at <time datetime="<%= status.changed_at.iso8601 %>"><%= status.changed_at.utc.strftime("%Y-%m-%d %H:%M:%S UTC") %></time><% end %>
      by <%= status.changed_by.presence || "unknown" %>.
    <% elsif status.degraded? %>
      The database is currently unreachable. Showing the last known state; changes cannot be saved right now.
    <% else %>
      Never changed here &mdash; this is the default.
    <% end %>
  </p>

  <div class="actions">
    <% if status.enabled? %>
      <%= button_to "Disable #{status.scope} Sentry", scoped_disable_path(scope: status.scope), method: :post, class: "btn danger" %>
    <% else %>
      <%= button_to "Enable #{status.scope} Sentry", scoped_enable_path(scope: status.scope), method: :post, class: "btn primary" %>
    <% end %>
  </div>

  <%= render "settings", status: status %>

  <p class="meta">
    <% if status.scope == Sentrifig::Scope::BACKEND %>
      Changes apply immediately to this process and to every other process of this environment within
      <%= status.cache_ttl %> seconds.
    <% else %>
      Changes are picked up by browser clients within their own poll interval
      (<%= Sentrifig.configuration.client_poll_interval %> seconds), with no reload or redeploy.
    <% end %>
  </p>
</div>
