<% sdk = @statuses.first %>
<% content_for :sdk do %>
  <% if sdk.sdk_ready? %>
    <span class="dot ok"></span>SDK ready to send
  <% else %>
    <span class="dot off"></span>SDK not sending: <%= Array(sdk.sdk_problems).join("; ") %>
  <% end %>
<% end %>

<div class="scopes">
  <%= render partial: "switch", collection: @statuses, as: :status %>
</div>
